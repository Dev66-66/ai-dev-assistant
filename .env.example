# LLM провайдер: "openrouter" или "ollama"
LLM_PROVIDER=openrouter

# OpenRouter (используется при LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Ollama (используется при LLM_PROVIDER=ollama)
# При запуске через Docker: host.docker.internal
# При запуске без Docker: localhost
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LSP_HOST=0.0.0.0
LSP_PORT=2087
